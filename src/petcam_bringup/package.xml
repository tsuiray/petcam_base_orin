<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>petcam_bringup</name>
  <version>0.1.0</version>
  <description>PetCam Orin base-station bringup: micro-ROS agent and future ROS 2 launch entries.</description>
  <maintainer email="tsuiming2@gmail.com">Cheuk Ming TSUI</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- micro_ros_agent is built into ~/microros_ws via scripts/install_microros_agent.sh -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
