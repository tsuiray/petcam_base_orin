Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Reference Frame: map
    - Class: rviz_default_plugins/Path
      Name: Path
      Enabled: true
      Topic:
        Value: /create_map/path
      Color: 255; 170; 0
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/Pose
      Name: Pose
      Enabled: true
      Topic:
        Value: /create_map/pose
      Shape: Arrow
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Current View
      Scale: 40
      X: 0
      Y: 0
Window Geometry:
  Height: 800
  Width: 1000
