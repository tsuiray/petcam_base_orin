<?xml version="1.0" encoding="UTF-8" ?>
<!--
  UDPv4 only (disable Shared Memory). Use SIMPLE discovery — do not require
  a Discovery Server, so micro_ros_agent can bind XRCE UDP :8888 even if
  fastdds tools are missing.
-->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_transport</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="petcam_udp_simple" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_transport</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
